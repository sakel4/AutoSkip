{
  "manifest_version": 3,
  "name": "V2 YouTube Auto Skip (Firefox)",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Manage Autoskip settings"
  },
  "permissions": [
    "storage"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "yt-auto-skip@example.local",
      "strict_min_version": "128.0"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": ["youtube-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
