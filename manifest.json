{
  "manifest_version": 3,
  "name": "AutoSkip",
  "version": "1.0.0",
  "version_name": "1.0.0 release",
  "description": "Autoskip: Ads Auto Skip Extension for Youtube & Youtube Music",
  "homepage_url": "https://sakel.dev/",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Manage Autoskip settings"
  },
  "host_permissions": [
    "https://www.youtube.com/watch?*",
    "https://youtube.com/watch?*",
    "https://music.youtube.com/watch?*",
    "https://www.music.youtube.com/watch?*"
  ],
  "permissions": ["storage", "debugger"],
  "incognito": "split",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch?*",
        "https://youtube.com/watch?*",
        "https://www.music.youtube.com/watch?*",
        "https://music.youtube.com/watch?*"
      ],
      "exclude_matches": [],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "all_frames": true
}
